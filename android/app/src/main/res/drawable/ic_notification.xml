<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon.

  Android tints notification icons to a flat single colour from API 21 on,
  so it MUST be a white-on-transparent silhouette. Passing
  @mipmap/ic_launcher (the usual shortcut, and what this service shipped
  with first) renders the full-colour mandala as a solid white square in
  the status bar, because every opaque pixel becomes white.

  A four-pointed star reads cleanly at 24dp, which an Om glyph does not —
  its counters close up and it turns to mush at status-bar size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Main star -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.5 L13.9,10.1 L22.5,12 L13.9,13.9 L12,22.5 L10.1,13.9 L1.5,12 L10.1,10.1 Z" />
    <!-- Two small companions, so it reads as sky rather than as a generic
         sparkle. Kept well inside the 24dp box to survive the system's
         icon padding. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19.5,3.5 L20.2,5.3 L22,6 L20.2,6.7 L19.5,8.5 L18.8,6.7 L17,6 L18.8,5.3 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.5,16 L5.1,17.4 L6.5,18 L5.1,18.6 L4.5,20 L3.9,18.6 L2.5,18 L3.9,17.4 Z" />
</vector>
